<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_one_approval_request_user" model="ir.rule">
        <field name="name">ONE ERP approvals: requester or approver</field>
        <field name="model_id" ref="model_one_approval_request"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('requester_id', '=', user.id), ('approver_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_one_approval_request_system" model="ir.rule">
        <field name="name">ONE ERP approvals: system manager full access</field>
        <field name="model_id" ref="model_one_approval_request"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
