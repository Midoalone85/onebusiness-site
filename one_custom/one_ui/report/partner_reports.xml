<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_one_aged_partner" model="ir.actions.report">
        <field name="name">ONE ERP Aging</field>
        <field name="model">one.finance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">one_ui.report_one_aged_partner</field>
        <field name="paperformat_id" ref="one_ui.paperformat_one_finance_a4"/>
        <field name="print_report_name">'ONE_Aging_%s' % object.date_to</field>
    </record>

    <record id="action_report_one_partner_statement" model="ir.actions.report">
        <field name="name">ONE ERP Partner Statement</field>
        <field name="model">one.finance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">one_ui.report_one_partner_statement</field>
        <field name="paperformat_id" ref="one_ui.paperformat_one_finance_a4"/>
        <field name="print_report_name">'ONE_Partner_Statement_%s_%s' % (object.partner_id.name or 'Partner', object.date_to)</field>
    </record>

    <template id="report_one_aged_partner">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="company" t-value="doc.company_id"/>
                <t t-call="web.external_layout">
                    <div class="page one_fin_pdf"
                         t-att-dir="'rtl' if (doc.env.context.get('lang') or '').startswith('ar') else 'ltr'">
                        <t t-call="one_ui.one_finance_pdf_styles"/>

                        <div class="one_fin_title">
                            <h2 t-out="report_title"/>
                            <div class="one_fin_subtitle">ONE ERP · Financial Report</div>
                        </div>

                        <table class="one_fin_meta">
                            <tr>
                                <td>
                                    <span class="label">Company</span>
                                    <span class="value" t-field="company.name"/>
                                </td>
                                <td>
                                    <span class="label">As of Date</span>
                                    <span class="value" t-out="date_to" t-options='{"widget": "date"}'/>
                                </td>
                                <td>
                                    <span class="label">Partner</span>
                                    <span class="value" t-out="partner.name if partner else 'All Partners'"/>
                                </td>
                            </tr>
                        </table>

                        <table class="one_fin_table">
                            <thead>
                                <tr>
                                    <th style="width:30%">Partner</th>
                                    <th style="width:11.6%" class="num">Current</th>
                                    <th style="width:11.6%" class="num">1-30 Days</th>
                                    <th style="width:11.6%" class="num">31-60 Days</th>
                                    <th style="width:11.6%" class="num">61-90 Days</th>
                                    <th style="width:11.6%" class="num">91+ Days</th>
                                    <th style="width:12%" class="num">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rows" t-as="row">
                                    <tr>
                                        <td>
                                            <strong t-out="row['partner'].name"/>
                                            <div class="account_name" t-if="row['partner'].vat">
                                                <span>VAT: </span><span t-out="row['partner'].vat"/>
                                            </div>
                                        </td>
                                        <td class="num">
                                            <span t-out="row['current']"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                        <td class="num">
                                            <span t-out="row['days_1_30']"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                        <td class="num">
                                            <span t-out="row['days_31_60']"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                        <td class="num">
                                            <span t-out="row['days_61_90']"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                        <td class="num">
                                            <span t-out="row['days_91_plus']"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                        <td class="num">
                                            <strong t-out="row['total']"
                                                    t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="one_total">
                                    <td>Total</td>
                                    <td class="num">
                                        <span t-out="totals['current']"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="num">
                                        <span t-out="totals['days_1_30']"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="num">
                                        <span t-out="totals['days_31_60']"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="num">
                                        <span t-out="totals['days_61_90']"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="num">
                                        <span t-out="totals['days_91_plus']"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="num">
                                        <strong t-out="totals['total']"
                                                t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="one_footer_note">Generated by ONE ERP</div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_one_partner_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="company" t-value="doc.company_id"/>
                <t t-call="web.external_layout">
                    <div class="page one_fin_pdf"
                         t-att-dir="'rtl' if (doc.env.context.get('lang') or '').startswith('ar') else 'ltr'">
                        <t t-call="one_ui.one_finance_pdf_styles"/>

                        <div class="one_fin_title">
                            <h2>Partner Statement</h2>
                            <div class="one_fin_subtitle">ONE ERP · Financial Report</div>
                        </div>

                        <table class="one_fin_meta">
                            <tr>
                                <td>
                                    <span class="label">Company</span>
                                    <span class="value" t-field="company.name"/>
                                </td>
                                <td>
                                    <span class="label">Partner</span>
                                    <span class="value" t-out="partner.name"/>
                                </td>
                                <td>
                                    <span class="label">From Date</span>
                                    <span class="value" t-out="date_from" t-options='{"widget": "date"}'/>
                                </td>
                                <td>
                                    <span class="label">To Date</span>
                                    <span class="value" t-out="date_to" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                        </table>

                        <div class="one_account_header">
                            Opening Balance:
                            <span class="one_account_meta"
                                  t-out="opening"
                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </div>

                        <table class="one_fin_table">
                            <thead>
                                <tr>
                                    <th style="width:10%">Date</th>
                                    <th style="width:15%">Entry</th>
                                    <th style="width:14%">Reference</th>
                                    <th style="width:25%">Description</th>
                                    <th style="width:12%" class="num">Debit</th>
                                    <th style="width:12%" class="num">Credit</th>
                                    <th style="width:12%" class="num">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rows" t-as="row">
                                    <t t-set="line" t-value="row['line']"/>
                                    <tr>
                                        <td><span t-field="line.date"/></td>
                                        <td><span t-field="line.move_id.name"/></td>
                                        <td t-out="line.ref or line.move_id.ref or '-'"/>
                                        <td t-out="line.name or '-'"/>
                                        <td class="num">
                                            <span t-field="line.debit"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                        <td class="num">
                                            <span t-field="line.credit"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                        <td class="num">
                                            <span t-out="row['balance']"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="one_total">
                                    <td colspan="4">Period Total</td>
                                    <td class="num">
                                        <span t-out="debit_total"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="num">
                                        <span t-out="credit_total"
                                              t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                    <td class="num">
                                        <strong t-out="closing"
                                                t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="one_footer_note">Generated by ONE ERP</div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
