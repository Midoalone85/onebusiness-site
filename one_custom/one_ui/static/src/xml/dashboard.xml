<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="one_ui.OneDashboard">
        <div class="one_dashboard one_v3" t-att-dir="state.lang.startsWith('ar') ? 'rtl' : 'ltr'">
            <header class="one_v3_header">
                <div class="one_v3_identity">
                    <span class="one_v3_logo" aria-hidden="true">ONE</span>
                    <div class="one_v3_identity_copy">
                        <strong>ONE ERP</strong>
                        <small t-esc="state.lang.startsWith('ar') ? 'منصة إدارة الأعمال' : 'Business management'"/>
                    </div>
                </div>
                <div class="one_v3_header_actions">
                    <div class="one_v3_language" role="group" aria-label="Language">
                        <button type="button" t-att-class="state.lang.startsWith('ar') ? 'active' : ''" t-on-click="() => this.switchLanguage('ar_001')">ع</button>
                        <button type="button" t-att-class="!state.lang.startsWith('ar') ? 'active' : ''" t-on-click="() => this.switchLanguage('en_US')">EN</button>
                    </div>
                    <button type="button" class="one_v3_all_link" t-on-click="() => state.showAllApps ? this.showHome() : this.showAllApps()">
                        <i t-att-class="state.showAllApps ? 'fa fa-home' : 'fa fa-th-large'"/>
                        <span t-esc="state.lang.startsWith('ar') ? (state.showAllApps ? 'الرئيسية' : 'التطبيقات') : (state.showAllApps ? 'Home' : 'Apps')"/>
                    </button>
                </div>
            </header>

            <t t-if="!state.showAllApps">
                <section class="one_v3_welcome">
                    <div class="one_v3_welcome_text">
                        <span class="one_v3_eyebrow" t-esc="state.lang.startsWith('ar') ? 'لوحة القيادة' : 'COMMAND CENTER'"/>
                        <h1 t-esc="state.lang.startsWith('ar') ? 'أعمالك في مكان واحد' : 'Your business, connected'"/>
                        <p t-esc="state.lang.startsWith('ar') ? 'تابع أداء شركتك وادخل إلى تطبيقاتك بسرعة.' : 'Track performance and access your daily tools in one place.'"/>
                    </div>
                    <span class="one_v3_welcome_emblem" aria-hidden="true"><i class="fa fa-line-chart"/></span>
                </section>

                <section class="one_v3_stat_grid" aria-label="Quick indicators">
                    <button type="button" class="one_v3_stat" t-on-click="() => this.open('one_ui.action_one_sales')">
                        <span class="one_v3_stat_icon"><i class="fa fa-line-chart"/></span>
                        <span class="one_v3_stat_copy"><small t-esc="state.lang.startsWith('ar') ? 'المبيعات' : 'Sales'"/><strong t-esc="state.sales"/></span>
                    </button>
                    <button type="button" class="one_v3_stat" t-on-click="() => this.open('one_ui.action_one_purchase')">
                        <span class="one_v3_stat_icon"><i class="fa fa-shopping-cart"/></span>
                        <span class="one_v3_stat_copy"><small t-esc="state.lang.startsWith('ar') ? 'المشتريات' : 'Purchases'"/><strong t-esc="state.purchases"/></span>
                    </button>
                    <button type="button" class="one_v3_stat" t-on-click="() => this.open('one_ui.action_one_inventory')">
                        <span class="one_v3_stat_icon"><i class="fa fa-cubes"/></span>
                        <span class="one_v3_stat_copy"><small t-esc="state.lang.startsWith('ar') ? 'التحويلات' : 'Transfers'"/><strong t-esc="state.transfers"/></span>
                    </button>
                    <button t-if="state.access.account" type="button" class="one_v3_stat" t-on-click="() => this.open('one_ui.action_one_accounting')">
                        <span class="one_v3_stat_icon"><i class="fa fa-file-text-o"/></span>
                        <span class="one_v3_stat_copy"><small t-esc="state.lang.startsWith('ar') ? 'الفواتير' : 'Invoices'"/><strong t-esc="state.invoices"/></span>
                    </button>
                    <button t-else="" type="button" class="one_v3_stat" t-on-click="() => this.open('one_ui.action_one_crm')">
                        <span class="one_v3_stat_icon"><i class="fa fa-bullseye"/></span>
                        <span class="one_v3_stat_copy"><small t-esc="state.lang.startsWith('ar') ? 'الفرص' : 'Leads'"/><strong t-esc="state.opportunities"/></span>
                    </button>
                </section>

                <section class="one_v3_main_section">
                    <div class="one_v3_section_header">
                        <div>
                            <span class="one_v3_section_kicker" t-esc="state.lang.startsWith('ar') ? 'مساحة العمل' : 'YOUR WORKSPACE'"/>
                            <h2 t-esc="state.lang.startsWith('ar') ? 'التطبيقات الرئيسية' : 'Your main apps'"/>
                        </div>
                        <button type="button" class="one_v3_more" t-on-click="() => this.showAllApps()">
                            <span t-esc="state.lang.startsWith('ar') ? 'كل التطبيقات' : 'All apps'"/>
                            <i class="fa fa-angle-left" t-if="state.lang.startsWith('ar')"/>
                            <i class="fa fa-angle-right" t-else=""/>
                        </button>
                    </div>
                    <div class="one_v3_app_grid">
                        <t t-foreach="homeApps" t-as="app" t-key="app.id">
                            <button type="button" class="one_v3_app" t-on-click="() => this.open(app.action)">
                                <span class="one_v3_app_icon"><i t-att-class="app.icon"/></span>
                                <span class="one_v3_app_label" t-esc="state.lang.startsWith('ar') ? app.ar : app.en"/>
                                <small t-esc="state.lang.startsWith('ar') ? app.descriptionAr : app.descriptionEn"/>
                            </button>
                        </t>
                    </div>
                </section>

                <div class="one_v3_panels">
                    <section t-if="state.access.account" class="one_v3_panel">
                        <div class="one_v3_panel_heading">
                            <span class="one_v3_panel_icon"><i class="fa fa-pie-chart"/></span>
                            <div>
                                <small t-esc="state.lang.startsWith('ar') ? 'نظرة مالية' : 'FINANCIAL PULSE'"/>
                                <h3 t-esc="state.lang.startsWith('ar') ? 'المؤشرات المالية' : 'Financial snapshot'"/>
                            </div>
                        </div>
                        <div class="one_v3_pulse">
                            <div><small t-esc="state.lang.startsWith('ar') ? 'الذمم المدينة' : 'Receivables'"/><strong t-esc="state.pulseReceivables"/></div>
                            <div><small t-esc="state.lang.startsWith('ar') ? 'الذمم الدائنة' : 'Payables'"/><strong t-esc="state.pulsePayables"/></div>
                            <div><small t-esc="state.lang.startsWith('ar') ? 'إيرادات الشهر' : 'Monthly revenue'"/><strong t-esc="state.pulseMonthRevenue"/></div>
                            <div><small t-esc="state.lang.startsWith('ar') ? 'ربح / خسارة الشهر' : 'Month profit / loss'"/><strong t-esc="state.pulseMonthProfit"/></div>
                        </div>
                        <button class="one_v3_panel_action" type="button" t-on-click="() => this.open('one_ui.action_one_financial_reports')">
                            <span t-esc="state.lang.startsWith('ar') ? 'عرض التقارير المالية' : 'View financial reports'"/>
                        </button>
                    </section>

                    <section class="one_v3_panel">
                        <div class="one_v3_panel_heading">
                            <span class="one_v3_panel_icon"><i class="fa fa-bell-o"/></span>
                            <div>
                                <small t-esc="state.lang.startsWith('ar') ? 'المتابعة اليومية' : 'TODAY'"/>
                                <h3 t-esc="state.lang.startsWith('ar') ? 'تحتاج متابعتك' : 'Needs attention'"/>
                            </div>
                        </div>
                        <div class="one_v3_attention">
                            <button type="button" t-on-click="() => this.open('one_ui.action_one_sales')">
                                <span t-esc="state.lang.startsWith('ar') ? 'عروض الأسعار المفتوحة' : 'Open quotations'"/>
                                <strong t-esc="state.draftQuotations"/>
                            </button>
                            <button type="button" t-on-click="() => this.open('one_ui.action_one_purchase')">
                                <span t-esc="state.lang.startsWith('ar') ? 'طلبات الشراء المعلقة' : 'Pending purchases'"/>
                                <strong t-esc="state.pendingPurchases"/>
                            </button>
                            <button type="button" t-on-click="() => this.open('one_ui.action_one_inventory')">
                                <span t-esc="state.lang.startsWith('ar') ? 'الاستلامات المعلقة' : 'Pending receipts'"/>
                                <strong t-esc="state.pendingReceipts"/>
                            </button>
                            <button type="button" t-on-click="() => this.open('one_ui.action_one_approvals')">
                                <span t-esc="state.lang.startsWith('ar') ? 'الموافقات المعلقة' : 'Pending approvals'"/>
                                <strong t-esc="state.pendingApprovals"/>
                            </button>
                        </div>
                    </section>
                </div>
            </t>

            <t t-else="">
                <section class="one_v3_library">
                    <div class="one_v3_section_header one_v3_library_head">
                        <div>
                            <span class="one_v3_section_kicker" t-esc="state.lang.startsWith('ar') ? 'ONE ERP' : 'ONE ERP'"/>
                            <h1 t-esc="state.lang.startsWith('ar') ? 'كل التطبيقات' : 'All applications'"/>
                            <p t-esc="state.lang.startsWith('ar') ? 'ابحث عن التطبيق المناسب وافتحه مباشرة.' : 'Find a module and get to work.'"/>
                        </div>
                        <button class="one_v3_more" type="button" t-on-click="() => this.showHome()">
                            <i class="fa fa-home"/>
                            <span t-esc="state.lang.startsWith('ar') ? 'الرئيسية' : 'Home'"/>
                        </button>
                    </div>
                    <div class="one_v3_search">
                        <i class="fa fa-search"/>
                        <input type="search" autocomplete="off" t-att-placeholder="state.lang.startsWith('ar') ? 'ابحث باسم التطبيق...' : 'Search applications...'" t-att-value="state.appQuery" t-on-input="(ev) => state.appQuery = ev.target.value"/>
                    </div>
                    <div class="one_v3_filters" role="group" aria-label="App categories">
                        <button type="button" t-att-class="state.category === 'all' ? 'active' : ''" t-on-click="() => this.setCategory('all')" t-esc="state.lang.startsWith('ar') ? 'الكل' : 'All'"/>
                        <button type="button" t-att-class="state.category === 'finance' ? 'active' : ''" t-on-click="() => this.setCategory('finance')" t-esc="state.lang.startsWith('ar') ? 'المالية' : 'Finance'"/>
                        <button type="button" t-att-class="state.category === 'operations' ? 'active' : ''" t-on-click="() => this.setCategory('operations')" t-esc="state.lang.startsWith('ar') ? 'العمليات' : 'Operations'"/>
                        <button type="button" t-att-class="state.category === 'people' ? 'active' : ''" t-on-click="() => this.setCategory('people')" t-esc="state.lang.startsWith('ar') ? 'الموظفون' : 'People'"/>
                        <button type="button" t-att-class="state.category === 'system' ? 'active' : ''" t-on-click="() => this.setCategory('system')" t-esc="state.lang.startsWith('ar') ? 'النظام' : 'System'"/>
                    </div>
                    <div class="one_v3_app_grid one_v3_library_grid">
                        <t t-foreach="filteredApps" t-as="app" t-key="app.id">
                            <button type="button" class="one_v3_app" t-on-click="() => this.open(app.action)">
                                <span class="one_v3_app_icon"><i t-att-class="app.icon"/></span>
                                <span class="one_v3_app_label" t-esc="state.lang.startsWith('ar') ? app.ar : app.en"/>
                                <small t-esc="state.lang.startsWith('ar') ? app.descriptionAr : app.descriptionEn"/>
                            </button>
                        </t>
                    </div>
                    <div t-if="!filteredApps.length" class="one_v3_empty">
                        <i class="fa fa-search"/>
                        <span t-esc="state.lang.startsWith('ar') ? 'لا توجد تطبيقات تطابق البحث' : 'No matching applications'"/>
                    </div>
                </section>
            </t>
        </div>
    </t>
</templates>
