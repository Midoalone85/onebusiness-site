<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="one_ui.OneDashboard">
    <div class="one_dashboard">
        <section class="one_hero">
            <div class="one_hero_copy">
                <div class="one_brandline">
                    <span class="one_brandmark">ONE</span>
                    <span class="one_eyebrow">ONE BUSINESS · BUSINESS OS</span>
                </div>
                <h1>ONE ERP</h1>
                <p>Business operations, finance and Saudi compliance in one connected workspace.</p>
            </div>
            <div class="one_hero_actions">
                <div class="one_language_switch" role="group" aria-label="Language">
                    <button type="button"
                            t-att-class="this.state.lang === 'ar_001' ? 'active' : ''"
                            t-on-click="() => this.switchLanguage('ar_001')">العربية</button>
                    <button type="button"
                            t-att-class="this.state.lang === 'en_US' ? 'active' : ''"
                            t-on-click="() => this.switchLanguage('en_US')">English</button>
                </div>
                <div class="one_hero_status">
                    <span class="one_live_dot"/>
                    <span>Workspace Ready</span>
                </div>
            </div>
        </section>

        <section class="one_kpi_grid">
            <button class="one_kpi" t-on-click="() => this.open('one_ui.action_one_sales')">
                <span class="one_kpi_icon"><i class="fa fa-line-chart"/></span>
                <span class="one_kpi_meta"><small>Sales</small><strong t-out="this.state.sales"/></span>
            </button>
            <button class="one_kpi" t-on-click="() => this.open('one_ui.action_one_purchase')">
                <span class="one_kpi_icon"><i class="fa fa-shopping-cart"/></span>
                <span class="one_kpi_meta"><small>Purchases</small><strong t-out="this.state.purchases"/></span>
            </button>
            <button class="one_kpi" t-on-click="() => this.open('one_ui.action_one_inventory')">
                <span class="one_kpi_icon"><i class="fa fa-cubes"/></span>
                <span class="one_kpi_meta"><small>Transfers</small><strong t-out="this.state.transfers"/></span>
            </button>
            <button class="one_kpi" t-on-click="() => this.open('one_ui.action_one_accounting')">
                <span class="one_kpi_icon"><i class="fa fa-calculator"/></span>
                <span class="one_kpi_meta"><small>Invoices</small><strong t-out="this.state.invoices"/></span>
            </button>
            <button class="one_kpi" t-on-click="() => this.open('one_ui.action_one_crm')">
                <span class="one_kpi_icon"><i class="fa fa-bullseye"/></span>
                <span class="one_kpi_meta"><small>CRM</small><strong t-out="this.state.opportunities"/></span>
            </button>
            <button class="one_kpi" t-on-click="() => this.open('one_ui.action_one_hr')">
                <span class="one_kpi_icon"><i class="fa fa-users"/></span>
                <span class="one_kpi_meta"><small>People</small><strong t-out="this.state.employees"/></span>
            </button>
        </section>

        <div class="one_dashboard_layout">
            <section class="one_workspace">
                <div class="one_section_title">
                    <div>
                        <span>CORE WORKSPACE</span>
                        <h2>Run the business</h2>
                    </div>
                </div>

                <div class="one_group">
                    <div class="one_group_label">Operations</div>
                    <div class="one_cards">
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_contacts')">
                            <i class="fa fa-address-book"/><b>Contacts</b><small>Customers and suppliers</small>
                        </button>
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_sales')">
                            <i class="fa fa-line-chart"/><b>Sales</b><small>Quotations and orders</small>
                        </button>
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_purchase')">
                            <i class="fa fa-shopping-cart"/><b>Purchases</b><small>Purchase orders and suppliers</small>
                        </button>
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_inventory')">
                            <i class="fa fa-cubes"/><b>Inventory</b><small>Stock and transfers</small>
                        </button>
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_products')">
                            <i class="fa fa-tags"/><b>Product Catalog</b><small>Items, services, prices and master data</small>
                        </button>
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_mrp')">
                            <i class="fa fa-industry"/><b>Manufacturing</b><small>Production and manufacturing orders</small>
                        </button>
                    </div>
                </div>

                <div class="one_group">
                    <div class="one_group_label">Finance &amp; Growth</div>
                    <div class="one_cards">
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_accounting')">
                            <i class="fa fa-calculator"/><b>Accounting</b><small>Invoices, journals and finance</small>
                        </button>
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_crm')">
                            <i class="fa fa-bullseye"/><b>CRM</b><small>Pipeline and opportunities</small>
                        </button>
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_hr')">
                            <i class="fa fa-users"/><b>People</b><small>Employees and human resources</small>
                        </button>
                        <button t-if="this.state.posAccess" class="one_card" t-on-click="() => this.open('one_ui.action_one_pos')">
                            <i class="fa fa-credit-card"/><b>Point of Sale</b><small>Registers and checkout</small>
                        </button>
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_ask')">
                            <i class="fa fa-comments-o"/><b>Ask ONE</b><small>Instant answers without external API</small>
                        </button>
                        <button class="one_card" t-on-click="() => this.open('one_ui.action_one_approvals')">
                            <i class="fa fa-check-square-o"/><b>Approval Center</b><small>Requests, decisions and controls</small>
                        </button>
                    </div>
                </div>
            </section>

            <aside class="one_side">
                <section class="one_panel one_panel_pulse">
                    <div class="one_panel_head">
                        <span class="one_panel_icon"><i class="fa fa-heartbeat"/></span>
                        <div><small>ONE PULSE</small><h3>Financial snapshot</h3></div>
                    </div>
                    <div class="one_pulse_grid">
                        <div><span>Receivables</span><strong t-out="this.state.pulseReceivables"/></div>
                        <div><span>Overdue</span><strong t-out="this.state.pulseOverdue"/></div>
                        <div><span>Payables</span><strong t-out="this.state.pulsePayables"/></div>
                        <div><span>Month revenue</span><strong t-out="this.state.pulseMonthRevenue"/></div>
                        <div class="one_pulse_wide"><span>Month profit / loss</span><strong t-out="this.state.pulseMonthProfit"/></div>
                    </div>
                    <button class="one_secondary_btn" t-on-click="() => this.open('one_ui.action_one_financial_reports')">
                        Open financial reports
                    </button>
                </section>

                <section class="one_panel one_panel_radar">
                    <div class="one_panel_head">
                        <span class="one_panel_icon"><i class="fa fa-rss"/></span>
                        <div><small>ONE BUSINESS RADAR</small><h3>Company health &amp; early warnings</h3></div>
                    </div>
                    <div class="one_radar_score">
                        <strong t-out="this.state.businessHealthScore"/>
                        <span>/100 · <t t-out="this.state.businessHealthStatus"/></span>
                    </div>
                    <div class="one_radar_alerts">
                        <t t-if="this.state.radarAlerts.length">
                            <t t-foreach="this.state.radarAlerts" t-as="alert" t-key="alert.key">
                                <button t-att-class="'one_radar_alert ' + alert.severity"
                                        t-on-click="() => this.open(alert.action)">
                                    <span>
                                        <b t-out="alert.title"/>
                                        <small t-out="alert.detail"/>
                                    </span>
                                    <i class="fa fa-chevron-right"/>
                                </button>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="one_radar_clear">
                                <i class="fa fa-check-circle"/>
                                <span>No urgent signals right now</span>
                            </div>
                        </t>
                    </div>
                </section>

                <section class="one_panel one_panel_attention">
                    <div class="one_panel_head">
                        <span class="one_panel_icon"><i class="fa fa-bolt"/></span>
                        <div><small>NEEDS ATTENTION</small><h3>Today's command center</h3></div>
                    </div>
                    <div class="one_attention_list">
                        <button t-on-click="() => this.open('one_ui.action_one_accounting')">
                            <span>Overdue receivables</span><strong t-out="this.state.overdueInvoices"/>
                        </button>
                        <button t-on-click="() => this.open('one_ui.action_one_accounting')">
                            <span>Unpaid customer invoices</span><strong t-out="this.state.unpaidInvoices"/>
                        </button>
                        <button t-on-click="() => this.open('one_ui.action_one_sales')">
                            <span>Open quotations</span><strong t-out="this.state.draftQuotations"/>
                        </button>
                        <button t-on-click="() => this.open('one_ui.action_one_purchase')">
                            <span>Purchases pending</span><strong t-out="this.state.pendingPurchases"/>
                        </button>
                        <button t-on-click="() => this.open('one_ui.action_one_inventory')">
                            <span>Receipts pending</span><strong t-out="this.state.pendingReceipts"/>
                        </button>
                        <button t-on-click="() => this.open('one_ui.action_one_approvals')">
                            <span>Approvals pending</span><strong t-out="this.state.pendingApprovals"/>
                        </button>
                    </div>
                </section>

                <section class="one_panel one_panel_compliance">
                    <div class="one_panel_head">
                        <span class="one_panel_icon"><i class="fa fa-shield"/></span>
                        <div><small>SAUDI COMPLIANCE</small><h3>ZATCA &amp; National Address</h3></div>
                    </div>
                    <div class="one_panel_metrics">
                        <div><span>Profiles</span><strong t-out="this.state.saudiProfiles"/></div>
                        <div><span>Ready for onboarding</span><strong t-out="this.state.zatcaReady"/></div>
                        <div><span>ZATCA connected</span><strong t-out="this.state.zatcaConnected"/></div>
                    </div>
                    <button class="one_primary_btn" t-on-click="() => this.open('one_ui.action_one_saudi_profile')">
                        Open compliance center
                    </button>
                </section>

                <section class="one_panel">
                    <div class="one_panel_head">
                        <span class="one_panel_icon"><i class="fa fa-key"/></span>
                        <div><small>SUBSCRIPTIONS</small><h3>Plans &amp; customer access</h3></div>
                    </div>
                    <div class="one_panel_metrics">
                        <div><span>Total</span><strong t-out="this.state.subscriptions"/></div>
                        <div><span>Active</span><strong t-out="this.state.activeSubscriptions"/></div>
                    </div>
                    <button class="one_secondary_btn" t-on-click="() => this.open('one_ui.action_one_subscriptions')">
                        Manage subscriptions
                    </button>
                </section>

                <section class="one_quick">
                    <button t-on-click="() => this.open('one_ui.action_one_contacts')">
                        <i class="fa fa-plus-circle"/><span><b>Contacts Center</b><small>Customers and suppliers</small></span>
                    </button>
                    <button t-on-click="() => this.open('one_ui.action_one_products')">
                        <i class="fa fa-tags"/><span><b>Product Catalog</b><small>Products, services and pricing</small></span>
                    </button>
                    <t t-if="this.state.adminAccess">
                        <button t-on-click="() => this.open('one_ui.action_one_control_center')">
                            <i class="fa fa-sliders"/><span><b>Control Center</b><small>Company, finance, compliance and platform setup</small></span>
                        </button>
                        <button t-on-click="() => this.open('one_ui.action_one_company_profile')">
                            <i class="fa fa-building"/><span><b>Company Profile</b><small>Legal identity and company data</small></span>
                        </button>
                        <button t-on-click="() => this.open('one_ui.action_one_users')">
                            <i class="fa fa-user-circle"/><span><b>Users &amp; Access</b><small>Team permissions and security</small></span>
                        </button>
                        <button t-on-click="() => this.open('one_ui.action_one_warehouses')">
                            <i class="fa fa-home"/><span><b>Warehouses</b><small>Storage locations and logistics setup</small></span>
                        </button>
                        <button t-on-click="() => this.open('one_ui.action_one_settings')">
                            <i class="fa fa-cog"/><span><b>System Settings</b><small>Permissions and preferences</small></span>
                        </button>
                    </t>
                </section>
            </aside>
        </div>
    </div>
</t>

<t t-name="one_ui.OneControlCenter">
    <div class="one_control_center">
        <section class="one_cc_hero">
            <div>
                <div class="one_cc_eyebrow">ONE BUSINESS · ADMINISTRATION</div>
                <h1>ONE Control Center</h1>
                <p>Configure the company, finance, operations, compliance and platform from one place.</p>
            </div>
            <div class="one_cc_badge"><i class="fa fa-shield"/> Administrator Workspace</div>
        </section>

        <section class="one_cc_stats">
            <div class="one_cc_stat"><span>Companies</span><strong t-out="this.state.companies"/></div>
            <div class="one_cc_stat"><span>Users</span><strong t-out="this.state.users"/></div>
            <div class="one_cc_stat"><span>Warehouses</span><strong t-out="this.state.warehouses"/></div>
            <div class="one_cc_stat"><span>Active Taxes</span><strong t-out="this.state.taxes"/></div>
            <div class="one_cc_stat"><span>Currencies</span><strong t-out="this.state.currencies"/></div>
            <div class="one_cc_stat"><span>Languages</span><strong t-out="this.state.languages"/></div>
        </section>

        <div class="one_cc_grid">
            <section class="one_cc_section">
                <div class="one_cc_section_head">
                    <span class="one_cc_icon"><i class="fa fa-building"/></span>
                    <div><small>ORGANIZATION</small><h2>Company &amp; access</h2></div>
                </div>
                <div class="one_cc_cards">
                    <button t-on-click="() => this.open('one_ui.action_one_company_profile')"><i class="fa fa-id-card"/><b>Company Profile</b><small>Legal identity, address and core company data</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_companies')"><i class="fa fa-sitemap"/><b>Companies &amp; Branches</b><small>Multi-company structure and branches</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_users')"><i class="fa fa-user-circle"/><b>Users &amp; Access</b><small>Users, permissions and access control</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_warehouses')"><i class="fa fa-home"/><b>Warehouses</b><small>Warehouses and logistics foundations</small></button>
                </div>
            </section>

            <section class="one_cc_section">
                <div class="one_cc_section_head">
                    <span class="one_cc_icon"><i class="fa fa-calculator"/></span>
                    <div><small>FINANCE &amp; TAX</small><h2>Financial foundations</h2></div>
                </div>
                <div class="one_cc_cards">
                    <button t-on-click="() => this.open('one_ui.action_one_chart_accounts')"><i class="fa fa-list-alt"/><b>Chart of Accounts</b><small>Accounting structure and classifications</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_journals')"><i class="fa fa-book"/><b>Journals</b><small>Sales, purchase, bank and miscellaneous journals</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_analytic_accounts')"><i class="fa fa-pie-chart"/><b>Cost Centers</b><small>Analytic accounts and management reporting dimensions</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_bank_cash')"><i class="fa fa-bank"/><b>Bank &amp; Cash</b><small>Bank and cash journals</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_taxes')"><i class="fa fa-percent"/><b>Taxes</b><small>VAT and tax configuration</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_payment_terms')"><i class="fa fa-calendar-check-o"/><b>Payment Terms</b><small>Customer and supplier payment schedules</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_fiscal_positions')"><i class="fa fa-random"/><b>Fiscal Positions</b><small>Tax mapping and fiscal treatment</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_currencies')"><i class="fa fa-money"/><b>Currencies</b><small>Active currencies and rates</small></button>
                </div>
            </section>

            <section class="one_cc_section">
                <div class="one_cc_section_head">
                    <span class="one_cc_icon"><i class="fa fa-cubes"/></span>
                    <div><small>OPERATIONS</small><h2>Products &amp; execution</h2></div>
                </div>
                <div class="one_cc_cards">
                    <button t-on-click="() => this.open('one_ui.action_one_products')"><i class="fa fa-tags"/><b>Product Catalog</b><small>Products, services and pricing master data</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_uom')"><i class="fa fa-balance-scale"/><b>Units of Measure</b><small>Units used in sales, purchase and inventory</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_mrp')"><i class="fa fa-industry"/><b>Manufacturing</b><small>Production and manufacturing setup</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_pos')"><i class="fa fa-credit-card"/><b>Point of Sale</b><small>Retail points and POS configuration</small></button>
                </div>
            </section>

            <section class="one_cc_section one_cc_section_saudi">
                <div class="one_cc_section_head">
                    <span class="one_cc_icon"><i class="fa fa-certificate"/></span>
                    <div><small>SAUDI ARABIA</small><h2>Compliance &amp; e-invoicing</h2></div>
                </div>
                <div class="one_cc_cards">
                    <button t-on-click="() => this.open('one_ui.action_one_saudi_profile')"><i class="fa fa-map-marker"/><b>Saudi Compliance</b><small>National Address, VAT and ZATCA readiness</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_taxes')"><i class="fa fa-percent"/><b>VAT Configuration</b><small>Review Saudi VAT setup</small></button>
                </div>
                <div class="one_cc_inline_status">
                    <span><b t-out="this.state.saudiProfiles"/> profiles</span>
                    <span><b t-out="this.state.plans"/> active plans</span>
                </div>
            </section>

            <section class="one_cc_section">
                <div class="one_cc_section_head">
                    <span class="one_cc_icon"><i class="fa fa-sliders"/></span>
                    <div><small>PLATFORM</small><h2>System &amp; commercial setup</h2></div>
                </div>
                <div class="one_cc_cards">
                    <button t-on-click="() => this.open('one_ui.action_one_languages')"><i class="fa fa-language"/><b>Languages</b><small>Enabled user interface languages</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_subscription_plans')"><i class="fa fa-diamond"/><b>Plans &amp; Features</b><small>Subscription packages and feature matrix</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_subscriptions')"><i class="fa fa-users"/><b>Customer Subscriptions</b><small>Customer plans and commercial terms</small></button>
                    <button t-on-click="() => this.open('one_ui.action_one_settings')"><i class="fa fa-cog"/><b>System Settings</b><small>Advanced configuration and integrations</small></button>
                </div>
            </section>
        </div>
    </div>
</t>

</templates>
