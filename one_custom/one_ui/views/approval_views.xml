<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_one_approval_request_list" model="ir.ui.view">
        <field name="name">one.approval.request.list</field>
        <field name="model">one.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Center"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-warning="state == 'submitted'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="approval_type"/>
                <field name="description"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="requester_id"/>
                <field name="approver_id"/>
                <field name="requested_at"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_one_approval_request_form" model="ir.ui.view">
        <field name="name">one.approval.request.form</field>
        <field name="model">one.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <field name="can_requester_action" invisible="1"/>
                    <field name="can_approver_action" invisible="1"/>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="oe_highlight"
                            invisible="state != 'draft' or not can_requester_action"/>
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="oe_highlight"
                            invisible="state != 'submitted' or not can_approver_action"/>
                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            invisible="state != 'submitted' or not can_approver_action"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel Request"
                            invisible="state not in ('draft', 'submitted') or not can_requester_action"/>
                    <button name="action_reset_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled') or not can_requester_action"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="approval_type" readonly="state != 'draft'"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="approver_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="document_reference" readonly="state != 'draft'"/>
                            <field name="source_url" widget="url" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group>
                        <field name="description"
                               placeholder="What needs approval and why?"
                               readonly="state != 'draft'"/>
                    </group>

                    <group string="Decision">
                        <group>
                            <field name="requested_at" readonly="1"/>
                            <field name="decided_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="decision_note"
                                   placeholder="Approval or rejection note"
                                   readonly="state != 'submitted' or not can_approver_action"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_one_approval_request_search" model="ir.ui.view">
        <field name="name">one.approval.request.search</field>
        <field name="model">one.approval.request</field>
        <field name="arch" type="xml">
            <search string="Approval Requests">
                <field name="name"/>
                <field name="description"/>
                <field name="requester_id"/>
                <field name="approver_id"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="My Requests" name="my_requests" domain="[('requester_id', '=', uid)]"/>
                <filter string="Assigned to Me" name="assigned_to_me" domain="[('approver_id', '=', uid)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'approval_type'}"/>
                    <filter string="Approver" name="group_approver" context="{'group_by': 'approver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_one_approvals" model="ir.actions.act_window">
        <field name="name">Approval Center</field>
        <field name="res_model">one.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_one_approval_request_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
