<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="one_web_layout_branding" inherit_id="web.layout" name="ONE ERP Web Branding">
        <xpath expr="//title" position="replace">
            <title>ONE ERP</title>
        </xpath>
        <xpath expr="//head" position="inside">
            <link rel="stylesheet" type="text/css" href="/one_ui/static/src/css/one_login.css"/>
            <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate"/>
            <meta http-equiv="Pragma" content="no-cache"/>
            <script type="text/javascript"><![CDATA[
                document.addEventListener("DOMContentLoaded", function () {
                    const form = document.querySelector("form.oe_login_form");
                    if (!form) return;
                    let submitted = false;
                    form.addEventListener("submit", function (event) {
                        if (submitted) {
                            event.preventDefault();
                            return false;
                        }
                        submitted = true;
                        const button = form.querySelector('button[type="submit"], input[type="submit"]');
                        if (button) {
                            button.disabled = true;
                            button.setAttribute("aria-disabled", "true");
                            if (button.tagName === "BUTTON") button.textContent = "Signing in…";
                        }
                        return true;
                    });
                });
            ]]></script>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/svg+xml" rel="shortcut icon" href="/one_ui/static/src/img/one_erp.svg"/>
        </xpath>
    </template>

    <template id="one_brand_promotion" inherit_id="web.brand_promotion" name="ONE Business Brand Promotion">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace">
            <div class="o_brand_promotion">ONE Business</div>
        </xpath>
    </template>

    <template id="one_login_layout_branding" inherit_id="web.login_layout" name="ONE ERP Login Branding">
        <xpath expr="//div[hasclass('card-body')]/div[hasclass('border-bottom')]" position="replace">
            <div class="text-center pb-3 border-bottom mb-4 one-login-brand">
                <img src="/one_ui/static/src/img/one_erp.svg" alt="ONE ERP" style="width:72px;height:72px;margin-bottom:12px;"/>
                <div style="font-size:30px;font-weight:800;line-height:1;color:#102a43;">ONE ERP</div>
                <div style="font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:#718096;margin-top:6px;">ONE Business</div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('card-body')]/div[hasclass('small') and hasclass('border-top')]" position="replace">
            <div class="text-center small mt-4 pt-3 border-top text-muted">
                ONE Business · Secure Business Workspace
            </div>
        </xpath>
    </template>
    <template id="one_webclient_bootstrap_guard" inherit_id="web.webclient_bootstrap" name="ONE ERP Webclient Guard">
        <xpath expr="//t[@t-set='head']/script[1]" position="after">
            <script type="text/javascript"><![CDATA[
                try {
                    localStorage.removeItem("current_tour");
                    localStorage.removeItem("current_tour.config");
                    localStorage.removeItem("current_tour.index");
                    localStorage.removeItem("current_tour.on_error");
                    if (window.odoo && odoo.__session_info__) {
                        odoo.__session_info__.current_tour = false;
                        odoo.__session_info__.tour_enabled = false;
                    }
                } catch (error) {
                    console.warn("ONE ERP startup guard", error);
                }
            ]]></script>
        </xpath>
    </template>

</odoo>
