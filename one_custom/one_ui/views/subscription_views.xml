<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_one_subscription_plan_list" model="ir.ui.view">
        <field name="name">one.subscription.plan.list</field>
        <field name="model">one.subscription.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="monthly_price"/>
                <field name="feature_accounting"/><field name="feature_mrp"/><field name="feature_saudi"/><field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_one_subscription_plan_form" model="ir.ui.view">
        <field name="name">one.subscription.plan.form</field>
        <field name="model">one.subscription.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="code"/><field name="monthly_price"/><field name="currency_id"/><field name="active"/>
                    </group>
                    <group string="Included Features" col="4">
                        <field name="feature_sales"/><field name="feature_purchase"/><field name="feature_inventory"/><field name="feature_accounting"/>
                        <field name="feature_crm"/><field name="feature_hr"/><field name="feature_mrp"/><field name="feature_reports"/>
                        <field name="feature_saudi"/><field name="feature_api"/><field name="feature_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_one_subscription_plans" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">one.subscription.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_one_subscription_list" model="ir.ui.view">
        <field name="name">one.subscription.list</field>
        <field name="model">one.subscription</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="partner_id"/><field name="plan_id"/><field name="date_start"/>
                <field name="date_end"/><field name="status"/><field name="users_limit"/>
            </list>
        </field>
    </record>

    <record id="view_one_subscription_form" model="ir.ui.view">
        <field name="name">one.subscription.form</field>
        <field name="model">one.subscription</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="partner_id"/><field name="plan_id"/><field name="status"/></group>
                        <group><field name="date_start"/><field name="date_end"/><field name="users_limit"/></group>
                    </group>
                    <field name="notes" placeholder="Commercial terms, implementation notes, exceptions..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_one_subscriptions" model="ir.actions.act_window">
        <field name="name">Customer Subscriptions</field>
        <field name="res_model">one.subscription</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
