<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_one_ask_wizard_form" model="ir.ui.view">
        <field name="name">one.ask.wizard.form</field>
        <field name="model">one.ask.wizard</field>
        <field name="arch" type="xml">
            <form string="Ask ONE">
                <sheet>
                    <div class="oe_title">
                        <h1>Ask ONE</h1>
                    </div>

                    <div class="alert alert-info" role="alert">
                        اسأل ONE عن الإيرادات والأرباح، أعمار ديون العملاء، أولويات التحصيل، أو طلب توصيات مالية. النتائج من قيود الشركة الحالية وبحسب صلاحيات المستخدم فقط. Ask ONE about revenue, profit, receivables aging, collection priorities and financial insights. Results are based on accessible company records.
                    </div>

                    <group>
                        <field name="question"
                               placeholder="مثال: أعمار الديون | تنصحني بإيه؟ | قارن أرباح الشهر | Compare revenue"/>
                    </group>

                    <group string="الإجابة | Answer" invisible="not answer">
                        <field name="answer" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_ask"
                            type="object"
                            string="Ask ONE"
                            class="oe_highlight"/>
                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_one_ask" model="ir.actions.act_window">
        <field name="name">Ask ONE</field>
        <field name="res_model">one.ask.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_one_ask_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
