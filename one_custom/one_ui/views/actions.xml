<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_one_dashboard" model="ir.actions.client">
        <field name="name">ONE ERP</field>
        <field name="tag">one_ui.dashboard</field>
    </record>

    <record id="action_one_contacts" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_sales" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_purchase" model="ir.actions.act_window">
        <field name="name">Purchases</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_inventory" model="ir.actions.act_window">
        <field name="name">Inventory Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_accounting" model="ir.actions.act_window">
        <field name="name">Invoices &amp; Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_journal_entries" model="ir.actions.act_window">
        <field name="name">Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'entry')]</field>
    </record>

    <record id="action_one_customer_invoices" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="action_one_vendor_bills" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund'))]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

    <record id="action_one_chart_accounts" model="ir.actions.act_window">
        <field name="name">Chart of Accounts</field>
        <field name="res_model">account.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_journals" model="ir.actions.act_window">
        <field name="name">Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_taxes" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="res_model">account.tax</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_mrp" model="ir.actions.act_window">
        <field name="name">Manufacturing</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_crm" model="ir.actions.act_window">
        <field name="name">CRM</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_hr" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
