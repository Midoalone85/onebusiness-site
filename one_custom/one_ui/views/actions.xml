<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_one_dashboard" model="ir.actions.client">
        <field name="name">ONE ERP</field>
        <field name="tag">one_ui.dashboard</field>
    </record>

    <record id="action_one_control_center" model="ir.actions.client">
        <field name="name">ONE Control Center</field>
        <field name="tag">one_ui.control_center</field>
    </record>

    <record id="action_one_contacts" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_sales" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_purchase" model="ir.actions.act_window">
        <field name="name">Purchases</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_inventory" model="ir.actions.act_window">
        <field name="name">Inventory Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_accounting" model="ir.actions.act_window">
        <field name="name">Invoices &amp; Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_journal_entries" model="ir.actions.act_window">
        <field name="name">Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'entry')]</field>
    </record>

    <record id="action_one_customer_invoices" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="action_one_vendor_bills" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund'))]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

    <record id="action_one_chart_accounts" model="ir.actions.act_window">
        <field name="name">Chart of Accounts</field>
        <field name="res_model">account.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_journals" model="ir.actions.act_window">
        <field name="name">Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_taxes" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="res_model">account.tax</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_mrp" model="ir.actions.act_window">
        <field name="name">Manufacturing</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_crm" model="ir.actions.act_window">
        <field name="name">CRM</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_pos" model="ir.actions.act_window">
        <field name="name">Point of Sale</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_hr" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_products" model="ir.actions.act_window">
        <field name="name">Product Catalog</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_warehouses" model="ir.actions.act_window">
        <field name="name">Warehouses</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_company_profile" model="ir.actions.act_window">
        <field name="name">Company Profile</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_users" model="ir.actions.act_window">
        <field name="name">Users &amp; Access</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_companies" model="ir.actions.act_window">
        <field name="name">Companies &amp; Branches</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_analytic_accounts" model="ir.actions.act_window">
        <field name="name">Cost Centers &amp; Analytic Accounts</field>
        <field name="res_model">account.analytic.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_bank_cash" model="ir.actions.act_window">
        <field name="name">Bank &amp; Cash Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('type', 'in', ('bank', 'cash'))]</field>
    </record>

    <record id="action_one_payment_terms" model="ir.actions.act_window">
        <field name="name">Payment Terms</field>
        <field name="res_model">account.payment.term</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_fiscal_positions" model="ir.actions.act_window">
        <field name="name">Fiscal Positions</field>
        <field name="res_model">account.fiscal.position</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_currencies" model="ir.actions.act_window">
        <field name="name">Currencies</field>
        <field name="res_model">res.currency</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_uom" model="ir.actions.act_window">
        <field name="name">Units of Measure</field>
        <field name="res_model">uom.uom</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_languages" model="ir.actions.act_window">
        <field name="name">Languages</field>
        <field name="res_model">res.lang</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- ONE ERP functional navigation actions -->
    <record id="action_one_sales_quotations" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ('draft', 'sent'))]</field>
        <field name="context">{'default_state': 'draft'}</field>
    </record>
    <record id="action_one_sales_orders" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ('sale', 'done'))]</field>
    </record>
    <record id="action_one_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
    </record>
    <record id="action_one_sales_analysis" model="ir.actions.act_window">
        <field name="name">Sales Analysis</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

    <record id="action_one_purchase_rfqs" model="ir.actions.act_window">
        <field name="name">Requests for Quotation</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ('draft', 'sent', 'to approve'))]</field>
    </record>
    <record id="action_one_purchase_orders" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ('purchase', 'done'))]</field>
    </record>
    <record id="action_one_vendors" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('supplier_rank', '&gt;', 0)]</field>
    </record>
    <record id="action_one_purchase_analysis" model="ir.actions.act_window">
        <field name="name">Purchase Analysis</field>
        <field name="res_model">purchase.report</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

    <record id="action_one_inventory_receipts" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('picking_type_code', '=', 'incoming')]</field>
    </record>
    <record id="action_one_inventory_deliveries" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('picking_type_code', '=', 'outgoing')]</field>
    </record>
    <record id="action_one_inventory_internal" model="ir.actions.act_window">
        <field name="name">Internal Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('picking_type_code', '=', 'internal')]</field>
    </record>
    <record id="action_one_stock_on_hand" model="ir.actions.act_window">
        <field name="name">On Hand</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="domain">[('location_id.usage', '=', 'internal')]</field>
    </record>
    <record id="action_one_reordering_rules" model="ir.actions.act_window">
        <field name="name">Reordering Rules</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_account_payments" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_one_mrp_bom" model="ir.actions.act_window">
        <field name="name">Bills of Materials</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_one_mrp_workcenters" model="ir.actions.act_window">
        <field name="name">Work Centers</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
    <record id="action_one_mrp_workorders" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_one_crm_leads" model="ir.actions.act_window">
        <field name="name">Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('type', '=', 'lead')]</field>
    </record>

    <record id="action_one_hr_departments" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="action_one_hr_jobs" model="ir.actions.act_window">
        <field name="name">Job Positions</field>
        <field name="res_model">hr.job</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_one_pos_orders" model="ir.actions.act_window">
        <field name="name">POS Orders</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_one_pos_payment_methods" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">pos.payment.method</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
